{
    "manifest_version": 3,
    "name": "IntelliTab",
    "version": "3.0.0",
    "description": "AI-powered browser extension that intelligently organizes tabs.",
    "permissions": [
        "tabs",
        "tabGroups",
        "storage",
        "alarms"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "src/background.ts",
        "type": "module"
    },
    "icons": {
        "48": "icon-48.png",
        "128": "icon-128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "48": "icon-48.png",
            "128": "icon-128.png"
        }
    },
    "options_page": "options.html",
    "commands": {
        "group-selected": {
            "suggested_key": {
                "default": "Alt+G",
                "mac": "Alt+G"
            },
            "description": "Group selected (highlighted) tabs"
        }
    }
}